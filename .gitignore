# Ignorar todo por defecto; whitelist de la estructura unificada limpia
/*
!/.gitignore
!/README.md
!/GUION_PRESENTACION_WORKSHOPS.md
!/requirements.txt
!/INFORME_INTEGRADO_WORKSHOPS_1_2_3.md
!/INFORME_INTEGRADO_WORKSHOPS_1_2_3.pdf
!/screenshots/
!/screenshots/*.png

# Backend unificado
!/backend/
/backend/*
!/backend/algorithms/
/backend/algorithms/*
!/backend/algorithms/*.py
!/backend/*.py
!/backend/data/
/backend/data/*
!/backend/data/*.json

# Frontend Next.js
!/frontend/
/frontend/*
!/frontend/src/
!/frontend/public/
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/tsconfig.json
!/frontend/next.config.ts
!/frontend/eslint.config.mjs

!/backend/static_results.json

# Ignorar artefactos generados y dependencias
__pycache__/
*.pyc
node_modules/
.next/
backend/__pycache__/
backend/algorithms/__pycache__/
frontend/.next/
frontend/node_modules/
